--name
devc-demo-hello
--hostname
hello
--init
--tz
local
--userns=keep-id:uid=1000,gid=1000
--user
1000:1000
--passwd-entry
dev:*:1000:1000:dev:/home/dev:/bin/sh
--http-proxy=false
--cap-drop=ALL
--security-opt
no-new-privileges
--security-opt
seccomp=/home/u/.local/share/devc/toolbox/seccomp.json
--security-opt
label=disable
--entrypoint
/opt/devc/bin/devc
--workdir
/w/demo/hello
--env
HOME=/home/dev
--env
USER=dev
--env
LOGNAME=dev
--env
DEVC_BOX=1
--env
DEVC_REALM=demo
--env
DEVC_PROJECT=hello
--env
PATH=/opt/devc/shims:/opt/devc/bin:/home/dev/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
--env
TERMINFO_DIRS=/opt/devc/terminfo:
--mount
type=bind,source=/home/u/devc/demo/hello,destination=/w/demo/hello
--mount
type=bind,source=/home/u/.local/share/devc/local/boxes/demo/hello/home,destination=/home/dev
--mount
type=bind,source=/home/u/.local/share/devc/cache/realms/demo/pkg,destination=/home/dev/.cache
--mount
type=bind,source=/home/u/.local/share/devc/cache/realms/demo/src,destination=/src
--mount
type=bind,source=/home/u/.local/share/devc/durable/realms/demo/context/notes/hello,destination=/ctx/notes
--mount
type=bind,source=/home/u/.local/share/devc/durable/realms/demo/context/memory/hello,destination=/ctx/memory
--mount
type=bind,source=/home/u/.local/share/devc/toolbox,destination=/opt/devc,ro
--mount
type=bind,source=/home/u/.local/share/devc/local/boxes/demo/hello/etc,destination=/etc/devc,ro
--mount
type=bind,source=/run/user/1001/devc/656931a916f2,destination=/run/devc
--label
devc.realm=demo
--label
devc.project=hello
--label
devc.role=box
--label
devc.confighash=9b6a7c0193f5a60653a75a9610dd0185024ccbf2b7681a29a0f80d34c19e99d6
docker.io/library/debian:trixie-slim
box
init
# warning: SELinux labelling is disabled for boxes (selinux.mode = "disable" in config.toml): the box is not confined by SELinux
