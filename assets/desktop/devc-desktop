#!/bin/bash
# devc-desktop: the program of devc's desktop sidecar (work order C19).
#
#   devc-desktop run       the container's command: waits for the secrets,
#                          then runs the display, the X relay, the web viewer
#                          and the window manager; ends when any of them ends
#   devc-desktop secrets   devc hands over the X authority file and the VNC
#                          password file as a tar archive on standard input
#                          (never as arguments or environment variables)
#   devc-desktop ready     waits until everything listens; fails as soon as a
#                          process has ended
#
# The container shares the box's network namespace and nothing else.
# Everything listens on 127.0.0.1 only: X on 6001 (display :1), VNC on 5901,
# noVNC on 6080. The X server needs the cookie, the VNC server the password.
set -euo pipefail

readonly dir=/tmp/devc
readonly xsock=/tmp/.X11-unix/X1

# Box programs open connections at will, and each costs the relays a
# process: socat forks one per X connection, websockify one per viewer
# connection. Both are bounded (connections beyond the bound wait in the
# listen queue); the container's PID and memory limits bound the rest.
readonly max_x=64 max_web=16

# websockify has no bound of its own: this runs it with its handler
# processes (multiprocessing.Process, one per connection) limited to
# argv[1] at a time; the accept loop waits while the limit is reached.
readonly web_bounded='
import multiprocessing, sys, time
from websockify import websocketproxy
limit = int(sys.argv[1])
start = multiprocessing.Process.start
def bounded(self):
    while len(multiprocessing.active_children()) >= limit:
        time.sleep(0.05)
    start(self)
multiprocessing.Process.start = bounded
sys.argv = ["websockify"] + sys.argv[2:]
sys.exit(websocketproxy.websockify_init())
'

log() { echo "devc-desktop: $*" >&2; }

# owns PID PORT: the process PID holds the socket listening on
# 127.0.0.1:PORT. A box process listening there first would make the
# sidecar's own listener fail; this tells the two apart.
owns() {
	local hex inode
	hex=$(printf '%04X' "$2")
	inode=$(awk -v a="0100007F:$hex" '$2 == a && $4 == "0A" { print $10; exit }' /proc/net/tcp)
	[ -n "$inode" ] || return 1
	ls -l "/proc/$1/fd" 2>/dev/null | grep -qF "socket:[$inode]"
}

case "${1:-}" in
secrets)
	umask 077
	mkdir -p /tmp/devc
	if [ -e /tmp/devc/secrets ]; then
		log "the secrets were delivered already"
		exit 1
	fi
	rm -rf /tmp/devc/incoming
	mkdir /tmp/devc/incoming
	tar -x -o -C /tmp/devc/incoming -f -
	for f in xauthority vncpasswd; do
		if [ ! -s "/tmp/devc/incoming/$f" ] || [ -L "/tmp/devc/incoming/$f" ]; then
			log "the delivery lacks $f"
			exit 1
		fi
	done
	mv /tmp/devc/incoming /tmp/devc/secrets
	;;

ready)
	for _ in $(seq 1 300); do
		if [ -s "$dir/pids" ]; then
			read -r xvnc relay web wm <"$dir/pids"
			for p in "$xvnc" "$relay" "$web" "$wm"; do
				if ! kill -0 "$p" 2>/dev/null; then
					log "a process of the desktop has ended:"
					tail -n 20 "$dir/log" >&2 || true
					exit 1
				fi
			done
			if [ -S "$xsock" ] && owns "$xvnc" 5901 && owns "$relay" 6001 && owns "$web" 6080; then
				exit 0
			fi
		fi
		sleep 0.1
	done
	log "the desktop did not start within 30 seconds:"
	tail -n 20 "$dir/log" >&2 || true
	exit 1
	;;

run)
	umask 077
	mkdir -p "$dir/home"
	export HOME="$dir/home"
	for _ in $(seq 1 1200); do
		[ -d "$dir/secrets" ] && break
		sleep 0.1
	done
	if [ ! -d "$dir/secrets" ]; then
		log "no secrets arrived within 120 seconds"
		exit 1
	fi
	mkdir -p -m 1777 /tmp/.X11-unix
	exec > >(tee -a "$dir/log") 2>&1
	name="${DEVC_DESKTOP_NAME:-devc}"
	# -nolisten tcp and local: X only on the sidecar's own socket file,
	# which socat offers on 127.0.0.1:6001; -nopn fails instead of running
	# with fewer listeners.
	Xvnc :1 -auth "$dir/secrets/xauthority" -rfbauth "$dir/secrets/vncpasswd" -SecurityTypes VncAuth \
		-interface 127.0.0.1 -rfbport 5901 -nolisten tcp -nolisten local -nopn \
		-geometry 1600x900 -depth 24 -desktop "$name" &
	xvnc=$!
	for _ in $(seq 1 100); do
		[ -S "$xsock" ] && break
		kill -0 "$xvnc" 2>/dev/null || break
		sleep 0.1
	done
	socat "TCP-LISTEN:6001,bind=127.0.0.1,reuseaddr,fork,max-children=$max_x" "UNIX-CONNECT:$xsock" &
	relay=$!
	python3 -c "$web_bounded" "$max_web" --web /usr/share/novnc 127.0.0.1:6080 127.0.0.1:5901 &
	web=$!
	DISPLAY=:1 XAUTHORITY="$dir/secrets/xauthority" matchbox-window-manager -use_titlebar yes &
	wm=$!
	echo "$xvnc $relay $web $wm" >"$dir/pids"
	set +e
	wait -n "$xvnc" "$relay" "$web" "$wm"
	status=$?
	log "a process of the desktop ended (status $status); stopping"
	kill "$xvnc" "$relay" "$web" "$wm" 2>/dev/null
	exit 1
	;;

*)
	log "usage: devc-desktop run|secrets|ready"
	exit 2
	;;
esac
