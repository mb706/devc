{
  "cleanupPeriodDays": 3650,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skipDangerousModePermissionPrompt": true,
  "autoMemoryDirectory": {{json .Memory}},
  "env": {
    "DISABLE_UPDATES": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": {{json (hook "SessionStart")}}}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": {{json (hook "UserPromptSubmit")}}}]}],
    "Stop": [{"hooks": [{"type": "command", "command": {{json (hook "Stop")}}}]}],
    "Notification": [{"hooks": [{"type": "command", "command": {{json (hook "Notification")}}}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": {{json (hook "SessionEnd")}}}]}],
    "WorktreeCreate": [{"hooks": [{"type": "command", "command": {{json (print .Helper " box worktree-hook create")}}}]}],
    "WorktreeRemove": [{"hooks": [{"type": "command", "command": {{json (print .Helper " box worktree-hook remove")}}}]}]
  }
}
